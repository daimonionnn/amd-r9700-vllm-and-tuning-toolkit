[Unit]
Description=Force PCIe root port 00:02.4 to retrain at higher link speed (R9700 #2)
# Run after PCI subsystem is up and amdgpu has bound the devices.
After=multi-user.target
Wants=multi-user.target

[Service]
Type=oneshot
# Auto-detect the primary user's home dir (UID 1000) at boot time so no username
# or path needs to be hardcoded.  The result is written to a volatile tmpfs file
# and loaded as an EnvironmentFile.  Adjust the path after the home dir if you
# keep the toolkit somewhere other than ~/development/.
ExecStartPre=/bin/sh -c 'echo "TOOLKIT_DIR=$(getent passwd 1000 | cut -d: -f6)/development/amd-r9700-vllm-and-tuning-toolkit" > /run/force-pcie-link.env'
EnvironmentFile=/run/force-pcie-link.env
# ExecStart must begin with an absolute path — systemd rejects a leading
# variable — so the shell expands TOOLKIT_DIR for us.
ExecStart=/bin/sh -c 'exec "${TOOLKIT_DIR}/tuning/force_pcie_link.sh"'
RemainAfterExit=yes
# Don't fail the boot if the retrain doesn't reach the target speed.
SuccessExitStatus=0

[Install]
WantedBy=multi-user.target
