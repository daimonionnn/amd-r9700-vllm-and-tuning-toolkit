# Debian packages
*.deb

# Build artifacts
*.o

# Compiled llama.cpp build outputs
llm/llama.cpp-rocm/
llm/llama.cpp-vulkan/

# Upstream source trees cloned separately
llm/flash-attention/
llm/llama.cpp-src/
llm/vllm-src/

# Local benchmark tool checkouts (use installed llama-benchy or uvx instead)
llama-benchy/

# Python virtual environments and caches
.venv/
**/.venv/
__pycache__/
**/__pycache__/
*.egg-info/
**/*.egg-info/
llm/rocm-venv/
llm/vllm-venv/

# Docker runtime data and local service state
vllm/docker/.data/

# Local scratch artifacts
/reddit.json
vllm/docker/bench_llama_benchy_ab_patch.py

# VS Code workspace settings (optional: remove to share settings)
.vscode/

# OS artifacts
.DS_Store
Thumbs.db

# Benchmark result logs (contain absolute paths)
# Note: "/*" ignores the contents, not the directory itself — a negation cannot
# re-include a file whose parent directory is excluded.
benchmark/results/*
vllm/results/

# Logs and temp files
*.log
*.tmp

# ...except the deep-prefill thermal telemetry, which is kept as evidence: these
# CSV/log pairs back the thermal-defect finding and its post-RMA retest in
# docs/r9700-mem-vendor-bios-variance.md. Small (~15 KB each) and worth versioning.
# Must come last so it also overrides the "*.log" rule above.
!benchmark/results/thermal_*.csv
!benchmark/results/thermal_*.log
